Agent {
  name = "rc1328-qa-onto agent",
  prompt_file = "prompt.md",
  run_as = "user:ian@textql.com",
  tools = [],
  model = "default",
  methodology = "adaptive",
  -- rc1328 qa comment fast_mode
  fast_mode = false,
  skip_org_default_channel = true,
  email_output = false,
  feed = true,
  feed_channels = ["Main feed"],
  memory = "agents/rc1328-qa-onto-agent/memory",
  callable_as_subagent = true,
  allow_ad_hoc_subagents = true,
  -- rc1328 qa comment enabled
  enabled = true
}
