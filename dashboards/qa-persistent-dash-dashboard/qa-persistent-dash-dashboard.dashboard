Dashboard {
  name = "QA Persistent Dash Dashboard",
  run_as = "user:ian@textql.com",
  description = "[refinery automation test persistent] Plotly Dash regression fixture on the warehouse summary. Published, no schedule.",
  type = "dash",
  entrypoint = "qa-persistent-dash-dashboard.py",
  data_sources = [
    { type = "sql_query", name = "warehouse_summary", connector = "id:37", query = "select left(close_date, 4) as category, count(*) as n, count(distinct account_id) as amount from public.opportunity group by 1 order by 1" }
  ],
  enabled = true
}
