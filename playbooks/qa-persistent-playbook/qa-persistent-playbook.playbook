Playbook {
  name = "QA Persistent Playbook",
  prompt_file = "prompt.md",
  run_as = "user:ian@textql.com",
  cron_string = "0 11 * * 1",
  schedule_timezone = "UTC",
  connectors = ["id:1", "id:37"],
  tools = ["sql", "python"],
  report_output_style = "concise",
  model = "default",
  email_recipients = ["ian@textql.com"],
  enabled = true
}
