DataApp {
  name = "rc1328-qa-ask lemur",
  run_as = "user:ian@textql.com",
  description = "[refinery automation test 1.3.28 apps] #17041 named-agent ana.ask polling",
  functions = [
    {
      name = "start",
      description = "start ask",
      path = "compute/start.py",
      parameters = [
        { name = "q", type = "string" },
        { name = "using", type = "string" }
      ]
    },
    {
      name = "poll",
      description = "poll ask",
      path = "compute/poll.py",
      parameters = [
        { name = "ask_id", type = "string" },
        { name = "cursor", type = "string" },
        { name = "using", type = "string" }
      ]
    }
  ],
  capabilities = [
    {
      type = "ask",
      name = "qa_agent",
      agent = "/agents/rc1328-qa-agent/rc1328-qa-agent.agent"
    },
    {
      type = "ask",
      name = "ask"
    }
  ]
}
