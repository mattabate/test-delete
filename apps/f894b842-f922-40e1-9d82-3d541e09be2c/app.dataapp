DataApp {
  name = "RC6 Probe lemur",
  run_as = "user:ian@textql.com",
  description = "Interactive explorer of synthetic sales deals: total amount by region with a stage filter, plus a slow_probe test compute function.",
  sources = [
    { name = "deals", type = "python_code", path = "sources/deals.py" }
  ],
  functions = [
    {
      name = "slow_probe",
      description = "Sleeps for the given number of seconds and returns how long it slept; used to test async/loading behavior.",
      path = "compute/slow_probe.py",
      parameters = [
        { name = "seconds", type = "number", description = "Number of seconds to sleep before returning." }
      ]
    }
  ]
}
