DataApp {
  name = "rc1328-qa-decide lemur",
  run_as = "user:ian@textql.com",
  description = "QA probe for 1.3.28 rc.1 #16984: ana.decide on text and images. Kept for Ian's review.",
  functions = [
    {
      name = "decide_text",
      description = "ana.decide on a support ticket text",
      path = "compute/decide_text.py",
      parameters = [
        { name = "text", type = "string" }
      ]
    },
    {
      name = "decide_image",
      description = "ana.decide on a generated red PNG passed as path/bytes/dict, plus bad inputs",
      path = "compute/decide_image.py",
      parameters = [
        { name = "mode", type = "string" }
      ]
    }
  ],
  capabilities = [
    {
      type = "decide",
      name = "decide"
    }
  ]
}
