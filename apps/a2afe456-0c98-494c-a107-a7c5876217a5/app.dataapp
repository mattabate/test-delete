DataApp {
  name = "Monkey Business",
  run_as = "user:rodney@textql.com",
  description = "A playful look at monkey troops and their banana consumption.",
  app_db_setup = [
    "CREATE TABLE upload_benchmarks (file_name TEXT, file_size_bytes BIGINT, upload_ms BIGINT, created_at TEXT)"
  ],
  sources = [
    { name = "troops", type = "python_code", path = "sources/troops.py" },
    { name = "weekly", type = "python_code", path = "sources/weekly.py" }
  ],
  functions = [
    {
      name = "upload_preview",
      description = "Preview rows and columns from an uploaded CSV/XLS/XLSX file (first sheet if a workbook), for the troop data upload grid.",
      path = "compute/upload_preview.sql",
      parameters = [
        { name = "file", type = "object", description = "Upload reference returned by ana.upload" }
      ]
    },
    {
      name = "log_upload_benchmark",
      description = "Record how long an ana.upload() call took for a file, for the upload benchmark panel.",
      path = "compute/log_upload_benchmark.sql",
      parameters = [
        { name = "file_name", type = "string", description = "Name of the uploaded file" },
        { name = "file_size_bytes", type = "number", description = "Size of the uploaded file in bytes" },
        { name = "upload_ms", type = "number", description = "Milliseconds the ana.upload() call took to resolve" }
      ]
    },
    {
      name = "list_upload_benchmarks",
      description = "Recent upload-time benchmark records, newest first, for the upload benchmark panel.",
      path = "compute/list_upload_benchmarks.sql"
    }
  ]
}
