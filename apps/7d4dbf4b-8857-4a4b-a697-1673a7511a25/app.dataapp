DataApp {
  name = "rc1328-qa-appdb lemur",
  run_as = "user:ian@textql.com",
  description = "[refinery automation test 1.3.28 appdb] App-DB snapshot performance probe for #17200/#17093. Keep for Ian's review.",
  app_db_setup = [
    "CREATE TABLE bulk (id BIGINT, c0 UBIGINT, c1 UBIGINT, c2 UBIGINT, c3 UBIGINT, c4 UBIGINT, c5 UBIGINT, c6 UBIGINT, c7 UBIGINT, c8 UBIGINT, c9 UBIGINT, c10 UBIGINT, c11 UBIGINT, c12 UBIGINT, c13 UBIGINT, c14 UBIGINT, c15 UBIGINT, c16 UBIGINT, c17 UBIGINT, c18 UBIGINT, c19 UBIGINT)",
    "CREATE TABLE marks (k TEXT, v TEXT, ts TEXT)"
  ],
  functions = [
    {
      name = "put_mark",
      description = "Insert one mark",
      path = "compute/put_mark.sql",
      parameters = [
        { name = "k", type = "string" },
        { name = "v", type = "string" }
      ]
    },
    {
      name = "get_mark",
      description = "Read marks by key",
      path = "compute/get_mark.sql",
      parameters = [
        { name = "k", type = "string" }
      ]
    },
    {
      name = "latest_marks",
      description = "Newest marks",
      path = "compute/latest_marks.sql"
    },
    {
      name = "stats",
      description = "Row counts",
      path = "compute/stats.sql"
    },
    {
      name = "db_size",
      description = "DuckDB file size",
      path = "compute/db_size.sql"
    },
    {
      name = "count_like",
      description = "Count marks by key prefix",
      path = "compute/count_like.sql",
      parameters = [
        { name = "p", type = "string" }
      ]
    },
    {
      name = "bulk_load",
      description = "Insert n deterministic rows starting at start",
      path = "compute/bulk_load.py",
      parameters = [
        { name = "start", type = "number" },
        { name = "n", type = "number" }
      ]
    },
    {
      name = "py_stats",
      description = "Row counts via python ana.sql",
      path = "compute/py_stats.py"
    }
  ]
}
