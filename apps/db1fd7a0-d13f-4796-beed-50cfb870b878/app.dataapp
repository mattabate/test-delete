DataApp {
  name = "rc-qa-fresh-apps-202611051825",
  run_as = "user:ian@textql.com",
  description = "Warehouse and usage health with a self-maintained visit log. [refinery automation test persistent]",
  app_db_setup = [
    "CREATE TABLE visits (id TEXT, note TEXT, source TEXT, created_at TEXT)",
    "CREATE TABLE heartbeat (id TEXT, source TEXT, created_at TEXT)"
  ],
  sources = [
    { name = "warehouse_summary", type = "sql_query", path = "sources/warehouse_summary.sql", connector = "id:37" },
    { name = "usage_daily", type = "sql_query", path = "sources/usage_daily.sql", connector = "id:1" },
    { name = "usage_window", type = "sql_query", path = "sources/usage_window.sql", connector = "id:1", parameters = [ { name = "days", type = "int", default = "7" } ] },
    { name = "reference_tiers", type = "python_code", path = "sources/reference_tiers.py" }
  ],
  functions = [
    {
      name = "app_db_stats",
      description = "Visit and heartbeat counts with the latest timestamps",
      path = "compute/app_db_stats.sql"
    },
    {
      name = "visit_notes",
      description = "Visit log, newest first",
      path = "compute/visit_notes.sql"
    },
    {
      name = "record_visit",
      description = "Append one visit to the log",
      path = "compute/record_visit.sql",
      parameters = [
        { name = "note", type = "string" },
        { name = "source", type = "string" }
      ]
    },
    {
      name = "record_heartbeat",
      description = "Append one heartbeat row (called by the daily job)",
      path = "compute/record_heartbeat.sql"
    },
    {
      name = "visit_tier",
      description = "Greets a name with the visit tier from the app database",
      path = "compute/visit_tier.py",
      parameters = [
        { name = "name", type = "string" }
      ]
    },
    {
      name = "live_usage",
      description = "Cells run per day over the last N days, live",
      path = "compute/live_usage.py",
      parameters = [
        { name = "days", type = "number" }
      ]
    },
    {
      name = "chats_live",
      description = "Chats started per day over the last N days, live via TQL",
      path = "compute/chats_live.tql",
      connector = "id:1",
      parameters = [
        { name = "days", type = "number" }
      ]
    }
  ],
  jobs = [
    {
      name = "daily_heartbeat",
      function = "record_heartbeat",
      description = "Writes one heartbeat row a day so the app database keeps moving",
      params_json = "{}",
      enabled = true,
      cron = "41 9 * * *",
      timezone = "UTC",
      timeout_seconds = 120
    }
  ]
}
