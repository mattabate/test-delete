DataApp {
  name = "RC9 Probe lemur",
  run_as = "user:ian@textql.com",
  description = "Synthetic sales deals explorer: amount by region with a stage filter, plus a slow_probe compute function for latency testing.",
  sources = [
    { name = "deals", type = "python_code", path = "sources/deals.py" }
  ],
  functions = [
    {
      name = "slow_probe",
      description = "Sleeps for the given number of seconds server-side, then returns how long it slept. Used to test async/loading UI behavior.",
      path = "compute/slow_probe.py",
      parameters = [
        { name = "seconds", type = "number", description = "Number of seconds to sleep before responding" }
      ]
    }
  ]
}
