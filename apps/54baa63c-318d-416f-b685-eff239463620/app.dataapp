DataApp {
  name = "Compute Timeout Tester",
  run_as = "user:ian@textql.com",
  description = "Manual test harness for verifying the pending PR that extends data-app compute/refresh timeouts from ~2-5 minutes up to 10 minutes. Fires python and SQL sleeps of chosen durations and reports elapsed time, status, and errors.",
  functions = [
    {
      name = "python_sleep",
      description = "Sleeps for the given number of seconds inside the python compute worker, to bracket the sandbox ScriptRequest timeout budget.",
      path = "compute/python_sleep.py",
      returns = "{seconds, completed} on success",
      parameters = [
        { name = "seconds", type = "number", description = "Number of seconds to sleep before returning." }
      ]
    },
    {
      name = "sql_sleep",
      description = "Runs a server-side wait of the given duration on the Snowflake connector via SYSTEM$WAIT, to bracket the ana.query connector dispatch HTTP timeout.",
      path = "compute/sql_sleep.tql",
      connector = "id:3",
      parameters = [
        { name = "seconds", type = "number", description = "Number of seconds the warehouse should wait before returning." }
      ]
    }
  ]
}
