---
default_connector: 3
---
-- Server-side wait against Snowflake, used to exercise the ana.query
-- connector dispatch HTTP timeout path (old limit ~120s, claimed new ~590s).
params {
  -- Number of seconds to wait via SYSTEM$WAIT before the query returns.
  seconds: Int
}

sql''
SELECT SYSTEM$WAIT(${seconds}, 'SECONDS') AS wait_result
''
