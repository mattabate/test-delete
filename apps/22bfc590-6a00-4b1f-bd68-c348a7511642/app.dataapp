DataApp {
  name = "RC9 Probe lemur",
  run_as = "user:ian@textql.com",
  sources = [
    { name = "deals", type = "python_code", path = "sources/deals.py" }
  ],
  functions = [
    {
      name = "slow_probe",
      description = "Sleeps for the given number of seconds and returns how long it slept. Used to test slow/async compute behavior.",
      path = "compute/slow_probe.py",
      returns = "An object {\"slept\": seconds} echoing the sleep duration.",
      parameters = [
        { name = "seconds", type = "number", description = "Number of seconds to sleep before returning." }
      ]
    }
  ]
}
