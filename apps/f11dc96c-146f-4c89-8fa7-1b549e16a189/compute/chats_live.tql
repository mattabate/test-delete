---
default_connector: 1
---
-- Chats started per day over the last N days, live from TextQL Usage.
params {
  -- Window length in days, for example 7 or 30.
  days: Int
}

sql''
SELECT date_trunc('day', created_at)::date AS day, count(*) AS chats
FROM ana_usage.chats
WHERE created_at > now() - make_interval(days => ${days})
GROUP BY 1
ORDER BY 1
''
